# Copie este arquivo para .env e preencha com as chaves do seu projeto Supabase.
# Onde encontrar: dashboard do Supabase → Project Settings → API
#
#   EXPO_PUBLIC_SUPABASE_URL       "Project URL"
#   EXPO_PUBLIC_SUPABASE_ANON_KEY  a chave "anon" / "public" (nas contas novas,
#                                  aparece como "publishable")
#
# Não use a chave "service_role" / "secret" aqui: ela ignora as regras de
# segurança do banco e nunca deve sair do servidor.
#
# Sem estas variáveis o aplicativo roda com os dados locais de src/data/mock.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
